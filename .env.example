# .env.example — Capitán Nirvana infra
# Copiar a .env y rellenar. NUNCA commitear .env a git.
# Los valores reales viven en password manager (vault "CN-Infra").

# ─────────────────────────────────────────────────────────────
# Restic + Hetzner Storage Box
# ─────────────────────────────────────────────────────────────
# Formato SFTP: sftp:USER@HOST:/PATH
# El USER se obtiene en Hetzner Robot → Storage Box → Sub-accounts
RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:/restic-repo-cn

# Password del repo restic. AES-256 encryption key. Sin esto los backups no se pueden leer.
# Generar con: openssl rand -base64 48
RESTIC_PASSWORD=<RANDOM_48_BYTES_BASE64>

# ─────────────────────────────────────────────────────────────
# Volúmenes EasyPanel (nombres reales en host)
# ─────────────────────────────────────────────────────────────
# Obtener con: docker volume ls
NOCODB_VOLUME_NAME=easypanel_nocodb_data
N8N_VOLUME_NAME=easypanel_n8n_data

# ─────────────────────────────────────────────────────────────
# Postgres (cuando se migre NocoDB y para dump n8n)
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres.easypanel.internal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<from password manager>
POSTGRES_DB_NOCODB=nocodb
POSTGRES_DB_N8N=n8n

# ─────────────────────────────────────────────────────────────
# Healthcheck (Uptime Kuma push monitor)
# ─────────────────────────────────────────────────────────────
# Crear monitor "Push" en Uptime Kuma con timeout 25h, copiar URL aquí.
HEALTHCHECK_URL=https://uptime-kuma.tudominio/api/push/<token>

# ─────────────────────────────────────────────────────────────
# Telegram alertas
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<from BotFather>
TELEGRAM_CHAT_ID=-100<id del chat 🚨 Alertas Infra CN>
